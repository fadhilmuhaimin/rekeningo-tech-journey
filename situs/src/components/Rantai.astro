---
/**
 * Diagram rantai (keputusan 212): baris-baris langkah berpanah dengan label baris, mis. "Sekarang" lawan
 * "Rekeningo v1", atau tiga opsi berdampingan. Simpul diberi nada token (system = baru/aturan, good = hasil benar,
 * warn = masalah, old = lama). Desktop: label di kiri, simpul mendatar; HP: label di atas, simpul menurun.
 *   <Rantai data={json} />
 * `ringkas` (K0a): untuk Inti, supaya diagram utuh di layar pertama 375×667. Di HP simpul mengalir mendatar dan
 * keterangan kecil (sub, catatan) disembunyikan; teks simpul harus bisa dibaca tanpa sub. Rinciannya di paragraf.
 *   <Rantai data={json} ringkas />
 * Rantai ringkas punya `li.rantai__panah` (aria-hidden) di antara dua simpul. Di HP panah itu item flex, jadi flex tidak
 * pernah menaruhnya di luar kolom saat simpul membungkus (P10, keputusan 366); di desktop ia tersembunyi dan panahnya ::after.
 */
import { DataRantai } from "../lib/rantai";

const d = DataRantai.parse(Astro.props.data);
const ringkas = Boolean(Astro.props.ringkas);
const CHIP: Record<string, string> = { rekaman: "is-system", ilustrasi: "is-warn", asumsi: "is-warn" };
---
<figure class:list={["rantai", { "rantai--ringkas": ringkas }]} aria-label={d.judul}>
  <figcaption class="rantai__judul"><strong>{d.judul}</strong> <span class:list={["bb-chip", CHIP[d.sumber.jenis]]}>{d.sumber.teks}</span></figcaption>
  {d.baris.map((b) => (
    <div class="rantai__baris">
      <p class="rantai__label"><b>{b.label}</b>{b.sub && <span>{b.sub}</span>}</p>
      <ol class="rantai__simpul">
        {b.simpul.map((s, i) => (
          <>
            {ringkas && i > 0 && <li class="rantai__panah" aria-hidden="true" data-pagefind-ignore>→</li>}
            <li class:list={[`is-${s.nada}`]}>
              {s.kode ? <code translate="no">{s.teks}</code> : <b>{s.teks}</b>}
              {s.sub && <span>{s.sub}</span>}
            </li>
          </>
        ))}
      </ol>
    </div>
  ))}
  {d.catatan && <p class="rantai__catatan">{d.catatan}</p>}
</figure>
