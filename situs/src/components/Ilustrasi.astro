---
/**
 * Ilustrasi kecil di awal blok cerita (keputusan 207): satu adegan yang dilihat tokoh, digambar dengan bentuk
 * datar dan token warna (gelap dan terang benar tanpa dua set gambar). Angka di gambar diambil dari teks adegan
 * di bawahnya, jadi gambar tidak membawa fakta baru. Label teks di gambar pendek; maknanya ada di aria-label.
 *   <Blok nama="Gejala" buka ilustrasi="m1">...</Blok>
 */
interface Props { nama: string }
const { nama } = Astro.props;
const LABEL: Record<string, string> = {
  prd: "Senin pagi: karyawan mengantre di kasir untuk tunjangan makan.",
  m1: "Layar HP Budi: membayar -Rp5.000 membuat saldo naik dari Rp250.000 ke Rp255.000.",
  m2: "App mengirim field amount, server membaca field jumlah.",
  m3: "Kotak pencarian berisi tanda kutip, layar menampilkan Error 500.",
  m4: "Layar HP Budi: pembayaran Rp70.000 gagal, tapi saldo turun dari Rp250.000 ke Rp180.000. Buku Warung Ani tidak mencatatnya.",
  m10: "Layar HP Budi: spinner berputar lama sesudah Bayar ditekan. Di sampingnya riwayat Budi dengan dua pembayaran yang sama untuk satu nasi goreng.",
  m5: "Layar HP Dimas: satu angka di alamat diganti, lalu saldo akun lain tampil. Di sampingnya spreadsheet berisi baris saldo semua akun.",
  m6: "Layar HP Budi saat makan siang: riwayat tidak bisa dimuat. Di sampingnya 11 HP yang belum diperbarui, semuanya masih error.",
  m9: "HP dan tablet Budi sama-sama menunjukkan transfer berhasil. Di sampingnya saldo Budi: Rp100.000 sebelum, di bawah nol sesudah.",
  m13: "HP Citra: lingkaran pemuatan berputar di atas layar pembayaran. Di tengah, deretan HP lain yang sama-sama menunggu. Di kanan, HP karyawan dengan app versi lama menampilkan kotak kesalahan.",
  m11: "HP Budi: lingkaran pemuatan berputar di atas daftar riwayat yang masih kosong. Di sampingnya layar laporan Ani menampilkan kotak kesalahan, dan sebuah jam menandai lamanya menunggu.",
  m12: "HP Budi: daftar riwayat yang digulir menampilkan dua baris yang sama berurutan. Di sampingnya kartu kiriman baru dari Dimas, dengan panah yang berhenti sebelum daftar itu.",
  m14: "HP Citra: kartu kiriman berhasil dengan tanda centang. Di sampingnya batang kiriman Rp800.000 yang melewati garis batas harian Rp500.000, dan di bawahnya dua cabang kode yang digabung menjadi satu.",
  m16: "HP Ani: layar menampilkan gembok. Di sampingnya satu laptop menarik garis ke empat kartu akun, dan satu kartu bertanda gembok berwarna peringatan."
  m15: "Dua lembar berdampingan di meja Pak Hadi dengan tanda tidak sama di antaranya: daftar file transfer dengan dua baris kembar berwarna peringatan, dan daftar ledger yang satu baris lebih pendek.",
};
if (!LABEL[nama]) throw new Error(`Ilustrasi "${nama}" tidak dikenal`);
