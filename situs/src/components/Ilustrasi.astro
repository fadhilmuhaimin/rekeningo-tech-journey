---
/**
 * Ilustrasi kecil di awal blok cerita (keputusan 207): satu adegan yang dilihat tokoh, digambar dengan bentuk
 * datar dan token warna (gelap dan terang benar tanpa dua set gambar). Angka di gambar diambil dari teks adegan
 * di bawahnya, jadi gambar tidak membawa fakta baru. Label teks di gambar pendek; maknanya ada di aria-label.
 *   <Blok nama="Gejala" buka ilustrasi="m1">...</Blok>
 */
interface Props { nama: string }
const { nama } = Astro.props;
const LABEL: Record<string, string> = {
  prd: "Senin pagi: karyawan mengantre di kasir untuk tunjangan makan.",
  m1: "Layar HP Budi: membayar -Rp5.000 membuat saldo naik dari Rp250.000 ke Rp255.000.",
  m2: "App mengirim field amount, server membaca field jumlah.",
  m3: "Kotak pencarian berisi tanda kutip, layar menampilkan Error 500.",
  m4: "Layar HP Budi: pembayaran Rp70.000 gagal, tapi saldo turun dari Rp250.000 ke Rp180.000. Buku Warung Ani tidak mencatatnya.",
  m10: "Layar HP Budi: spinner berputar lama sesudah Bayar ditekan. Di sampingnya riwayat Budi dengan dua pembayaran yang sama untuk satu nasi goreng.",
  m5: "Layar HP Dimas: satu angka di alamat diganti, lalu saldo akun lain tampil. Di sampingnya spreadsheet berisi baris saldo semua akun.",
  m6: "Layar HP Budi saat makan siang: riwayat tidak bisa dimuat. Di sampingnya 11 HP yang belum diperbarui, semuanya masih error.",
  m9: "HP dan tablet Budi sama-sama menunjukkan transfer berhasil. Di sampingnya saldo Budi: Rp100.000 sebelum, di bawah nol sesudah.",
};
if (!LABEL[nama]) throw new Error(`Ilustrasi "${nama}" tidak dikenal`);
---
<figure class="blok__ilustrasi" role="img" aria-label={LABEL[nama]}>
  {nama === "prd" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="140" y="34" width="52" height="56" rx="4" />
      <rect class="il-aksen-isi" x="146" y="42" width="40" height="14" rx="2" />
      <text class="il-teks-aksen" x="166" y="52.5" text-anchor="middle">Kasir</text>
      {[0, 1, 2, 3, 4].map((i) => (
        <g transform={`translate(${118 - i * 24} 0)`}>
          <circle class="il-orang" cx="0" cy="52" r="7" />
          <rect class="il-orang" x="-8" y="62" width="16" height="26" rx="6" />
        </g>
      ))}
      <line class="il-garis" x1="4" y1="90" x2="196" y2="90" />
      <text class="il-teks-2" x="4" y="106">Senin, 3 jam</text>
    </svg>
  )}
  {nama === "m1" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="8" y="4" width="76" height="102" rx="10" />
      <text class="il-teks-2" x="46" y="24" text-anchor="middle">Bayar</text>
      <rect class="il-warn" x="16" y="34" width="60" height="20" rx="4" />
      <text class="il-teks-warn" x="46" y="48" text-anchor="middle">-5000</text>
      <rect class="il-aksen-isi" x="16" y="66" width="60" height="18" rx="4" />
      <text class="il-teks-aksen" x="46" y="79" text-anchor="middle">Bayar</text>
      <text class="il-teks-2" x="104" y="34">Saldo Budi</text>
      <text class="il-teks" x="104" y="56">Rp250.000</text>
      <text class="il-teks-warn" x="104" y="80">Rp255.000 ↑</text>
    </svg>
  )}
  {nama === "m2" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="4" y="14" width="64" height="86" rx="10" />
      <text class="il-teks-2" x="36" y="34" text-anchor="middle">App</text>
      <rect class="il-aksen-isi" x="7" y="48" width="58" height="20" rx="4" />
      <text class="il-teks-aksen il-mono" x="36" y="62" text-anchor="middle">amount</text>
      <line class="il-garis" x1="72" y1="58" x2="124" y2="58" />
      <text class="il-teks-warn" x="98" y="50" text-anchor="middle">≠</text>
      <rect class="il-isi il-garis" x="128" y="14" width="68" height="86" rx="6" />
      <text class="il-teks-2" x="162" y="34" text-anchor="middle">Server</text>
      <rect class="il-warn" x="132" y="48" width="60" height="20" rx="4" />
      <text class="il-teks-warn il-mono" x="162" y="62" text-anchor="middle">jumlah</text>
    </svg>
  )}
  {nama === "m3" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="8" y="4" width="92" height="102" rx="10" />
      <rect class="il-garis il-latar" x="16" y="16" width="76" height="20" rx="10" />
      <text class="il-teks il-mono" x="26" y="30">'nasi</text>
      <rect class="il-warn" x="16" y="48" width="76" height="40" rx="6" />
      <text class="il-teks-warn" x="54" y="73" text-anchor="middle">Error 500</text>
      <text class="il-teks-2" x="114" y="40">Budi mencari</text>
      <text class="il-teks-2" x="114" y="58">warung</text>
      <text class="il-teks-2" x="114" y="76">nasi goreng</text>
    </svg>
  )}
  {nama === "m4" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="4" y="4" width="92" height="102" rx="10" />
      <rect class="il-warn" x="12" y="14" width="76" height="22" rx="4" />
      <text class="il-teks-warn" x="50" y="29.5" text-anchor="middle">Gagal</text>
      <text class="il-teks-2" x="50" y="54" text-anchor="middle">Saldo</text>
      <text class="il-teks-2 il-coret" x="50" y="74" text-anchor="middle">Rp250.000</text>
      <text class="il-teks" x="50" y="94" text-anchor="middle">Rp180.000</text>
      <rect class="il-isi il-garis" x="112" y="14" width="84" height="92" rx="4" />
      <text class="il-teks-2" x="154" y="32" text-anchor="middle">Buku Ani</text>
      <line class="il-garis" x1="120" y1="44" x2="188" y2="44" />
      <line class="il-garis" x1="120" y1="60" x2="188" y2="60" />
      <line class="il-garis" x1="120" y1="76" x2="188" y2="76" />
      <text class="il-teks-warn" x="154" y="96" text-anchor="middle">Rp70.000?</text>
    </svg>
  )}
  {nama === "m10" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="8" y="4" width="76" height="102" rx="10" />
      <rect class="il-orang" x="16" y="14" width="34" height="5" rx="2" />
      <circle class="il-garis" cx="46" cy="46" r="14" />
      <circle class="il-aksen-isi" cx="46" cy="32" r="4" />
      <rect class="il-aksen-isi" x="16" y="78" width="60" height="16" rx="4" />
      <line class="il-garis" x1="90" y1="55" x2="108" y2="55" />
      <path class="il-garis" d="M103 50 L109 55 L103 60" />
      <rect class="il-isi il-garis" x="114" y="10" width="82" height="92" rx="4" />
      <rect class="il-orang" x="122" y="20" width="30" height="6" rx="1" />
      <rect class="il-orang" x="160" y="20" width="28" height="6" rx="1" />
      {[0, 1].map((i) => (
        <g transform={`translate(0 ${i * 22})`}>
          <rect class="il-warn" x="120" y="38" width="70" height="16" rx="3" />
        </g>
      ))}
      <line class="il-garis" x1="122" y1="90" x2="188" y2="90" />
    </svg>
  )}
  {nama === "m5" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="8" y="4" width="76" height="102" rx="10" />
      <rect class="il-garis il-latar" x="14" y="14" width="64" height="14" rx="7" />
      <rect class="il-orang" x="20" y="19" width="28" height="4" rx="2" />
      <rect class="il-warn" x="52" y="17" width="18" height="8" rx="2" />
      <rect class="il-warn" x="14" y="38" width="64" height="30" rx="4" />
      <rect class="il-orang" x="14" y="78" width="44" height="5" rx="2" />
      <rect class="il-orang" x="14" y="89" width="30" height="5" rx="2" />
      <line class="il-garis" x1="90" y1="55" x2="108" y2="55" />
      <path class="il-garis" d="M103 50 L109 55 L103 60" />
      <rect class="il-isi il-garis" x="114" y="10" width="82" height="92" rx="4" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <g transform={`translate(0 ${i * 12})`}>
          <rect class={i === 2 ? "il-warn" : "il-orang"} x="120" y="18" width="16" height="6" rx="1" />
          <rect class={i === 2 ? "il-warn" : "il-orang"} x="140" y="18" width="26" height="6" rx="1" />
          <rect class={i === 2 ? "il-warn" : "il-orang"} x="170" y="18" width="20" height="6" rx="1" />
        </g>
      ))}
    </svg>
  )}
  {nama === "m6" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="8" y="4" width="76" height="102" rx="10" />
      <rect class="il-orang" x="16" y="14" width="34" height="5" rx="2" />
      <rect class="il-warn" x="14" y="28" width="64" height="40" rx="4" />
      <rect class="il-orang" x="14" y="78" width="44" height="5" rx="2" />
      <rect class="il-aksen-isi" x="14" y="88" width="64" height="12" rx="4" />
      {[...Array(11).keys()].map((i) => (
        <g transform={`translate(${108 + (i % 4) * 22} ${8 + Math.floor(i / 4) * 34})`}>
          <rect class="il-isi il-garis" x="0" y="0" width="16" height="28" rx="3" />
          <rect class="il-warn" x="3" y="5" width="10" height="14" rx="1" />
        </g>
      ))}
    </svg>
  )}
  {nama === "m9" && (
    <svg viewBox="0 0 200 110" width="200" height="110" aria-hidden="true">
      <rect class="il-isi il-garis" x="4" y="6" width="46" height="98" rx="8" />
      <rect class="il-orang" x="10" y="16" width="24" height="5" rx="2" />
      <rect class="il-aksen-isi" x="10" y="34" width="34" height="30" rx="4" />
      <path class="il-garis" d="M18 49 L24 55 L36 43" />
      <rect class="il-orang" x="10" y="76" width="30" height="5" rx="2" />
      <rect class="il-isi il-garis" x="58" y="18" width="70" height="86" rx="6" />
      <rect class="il-orang" x="66" y="28" width="30" height="5" rx="2" />
      <rect class="il-aksen-isi" x="66" y="42" width="54" height="30" rx="4" />
      <path class="il-garis" d="M85 57 L91 63 L103 51" />
      <rect class="il-orang" x="66" y="84" width="40" height="5" rx="2" />
      <rect class="il-orang" x="144" y="26" width="18" height="44" rx="2" />
      <rect class="il-warn" x="172" y="70" width="18" height="9" rx="2" />
      <line class="il-garis" x1="138" y1="70" x2="196" y2="70" />
    </svg>
  )}
</figure>
