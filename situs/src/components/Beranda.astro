---
/**
 * Beranda (keputusan 121, dirombak 208). Layar pertama: judul, satu kalimat, "Mulai dari PRD", kartu Lanjutkan
 * (dari localStorage), tiga pintu (Cerita, Peran, Masalah) sebagai tautan ke bagiannya, dan teka-teki Rp70.000
 * (widget tebak) yang mengajak pembaca berpikir sebelum membaca. Di bawahnya tiga pintu itu sendiri: peta enam
 * tahap yang bisa dipilih, peran sebagai pertanyaan dengan lima halaman saran, dan pencarian masalah dengan saran.
 * Semua data dari registry; tanpa server. Diagram peta adalah satu island DiagramArsitektur (I5b, keputusan 248):
 * tab mengirim tahap terpilih, diagram berganti dengan gerak singkat; Tahap 6 (proyeksi) tanpa diagram.
 */
import { muat, label, url, urutanBaca } from "../../tools/registri.mjs";
import Tebak from "../widgets/tebak/Tebak.tsx";
import tebakM4 from "../../data/widget/beranda-m4-tebak.json";
import PetaDiagram from "../diagram/PetaDiagram";
import { Arsitektur } from "../diagram/skema";
import { varPesan } from "../diagram/tata";

type H = { id: string; judul: string; tahap: unknown; path: string; ada?: boolean; masalah?: string; nomor?: string; peran?: string[]; inti?: boolean; menit?: number };
type Node = { label: string; baru?: boolean; berubah?: boolean; catatan?: string; lepas?: boolean };
type Skala = { pendek: string; lingkup: string; user: string; pembuat: string; prd: string };
type T = { no: number; nama: string; versi?: string; skala?: Skala; arsitektur?: { baris: Node[][]; caption?: string } };
const d = muat();
const hs: H[] = d.halaman;
const urut: H[] = urutanBaca(d);
const cari = (id: string) => hs.find((h) => h.id === id && h.ada);
const prd = cari("t1-prd");
const mulai = prd ?? urut.find((h) => h.tahap === 1);
const awalTahap = (no: number) => urut.find((h) => h.tahap === no);

// Tautan setelah teka-teki: halaman M4 bila sudah ada, kalau belum dasar-dasarnya.
const tautanTebak = [cari("t1-m4"), cari("t1-pertukaran-saldo"), cari("B3.1")]
  .filter((h): h is H => !!h)
  .slice(0, 2)
  .map((h) => ({ label: label(h), href: url(h) }));

const t1 = hs.filter((h) => h.tahap === 1 && h.nomor);
type Peta = { no: number; nama: string; skala?: Skala; diagram?: { baris: Node[][]; caption?: string }; status: string; lama: boolean; href?: string };
const tahap: Peta[] = [
  ...d.tahap.map((t: T) => ({
    no: t.no, nama: t.nama, skala: t.skala, diagram: t.arsitektur,
    status: t.versi === "lama" ? "Versi lama tersedia; ditulis ulang setelah Tahap 1" : `Sedang ditulis: ${t1.filter((h) => h.ada).length} dari ${t1.length} halaman`,
    lama: t.versi === "lama",
    href: awalTahap(t.no) ? url(awalTahap(t.no)!) : undefined,
  })),
  ...d.proyeksi.map((t: T) => ({ no: t.no, nama: t.nama, skala: t.skala, diagram: undefined, status: "Proyeksi, belum ditulis", lama: false, href: undefined })),
];

const diagramTahap = tahap.map((t) => ({ no: t.no, data: t.diagram ? Arsitektur.parse(t.diagram) : null, lama: t.lama }));
// Diagram yang belum mengikuti tab terpilih tidak terlihat (review PR #161, keputusan 248). Tab bisa dipilih sebelum
// island di-hydrate, dan sesudah hydrate React baru membaca data-tahap di efek; selama itu isinya masih versi SSR
// (Tahap 1). Tanpa JS tab tidak berganti, jadi data-tahap tetap tahap pertama dan diagramnya terlihat bersama panelnya.
const cssPeta = tahap.map((t) => `.peta__tab[data-tahap="${t.no}"] + .peta__isi .peta__diagram:not([data-peta-diagram="${t.no}"])`).join(",\n") + " { visibility: hidden; }";
// Selama diagram belum mengikuti tab (tab dipilih sebelum hydrate), wadahnya memesan tinggi tahap terpilih, bukan
// Tahap 1 dari SSR; nilainya sama dengan varPesan di komponen. Kaki asli Tahap 1 (figcaption, catatan) disembunyikan
// dan kaki tahap terpilih dari .peta__pesan di PetaDiagram.tsx ditampilkan (K1xa); tahap proyeksi tanpa diagram
// menyembunyikan seluruh figure dan hanya menampilkan catatannya. Semua ini di dalam diagram yang masih tersembunyi.
// Diukur dengan situs/tools/ukur-diagram.mjs bagian 6: di 375×667 tiap tab Tahap 2–6 ditap sebelum hydrate (modul JS
// ditunda 1,5 s), lalu geser terbesar dan CLS sesudah hydrate dicatat. Sebelum K1xa (hanya wadah yang dipesan):
// Tahap 2 dan 3 geser 63 px (CLS 0,0105), Tahap 4 dan 5 geser 41 px (CLS 0,0067), Tahap 6 0 px. Sesudah K1xa:
// Tahap 2–6 geser 0 px, CLS 0 (bagian 6 mensyaratkan keduanya nol).
const cssPesan = diagramTahap.map((t) => {
  const sel = `.peta__tab[data-tahap="${t.no}"] + .peta__isi .peta__diagram:not([data-peta-diagram="${t.no}"])`;
  const kaki = `${sel} [data-pesan-kaki="${t.no}"] { display: block; }`;
  return t.data
    ? `${sel} .diagram__wadah { ${Object.entries(varPesan(t.data)).map(([k, v]) => `${k}: ${v};`).join(" ")} }\n${sel} > .diagram figcaption, ${sel} > .peta__catatan { display: none; }\n${kaki}`
    : `${sel} > .diagram, ${sel} > .peta__catatan { display: none; }\n${kaki}`;
}).join("\n");

// Peran sebagai pertanyaan: lima halaman pertama yang menonjolkan peran itu, menurut urutan baca.
const PERAN: [string, string][] = [
  ["mobile", "App mobile"], ["web", "Dashboard web"], ["backend", "Server dan API"],
  ["devops", "Deploy dan server"], ["security", "Keamanan"], ["generalis", "Belum tahu, ingin semuanya"],
];
const saranPeran = Object.fromEntries(PERAN.map(([p]) => [p, urut
  .filter((h) => h.ada && (p === "generalis" ? h.inti : h.peran?.includes(p)))
  .slice(0, 5)
  .map((h) => ({ l: label(h), u: url(h), m: h.menit }))]));

// Pencarian masalah: data dan saran kata kunci yang pasti memberi hasil.
const masalah = hs.filter((h) => h.ada && h.masalah).map((h) => ({ m: h.masalah!, l: label(h), u: url(h) }));
const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
const cocok = (q: string) => masalah.filter((x) => norm(q).split(/\s+/).every((k) => norm(x.m + " " + x.l).includes(k)));
const saranCari = ["saldo hilang", "nominal minus", "error 500", "dobel bayar", "app versi lama", "deploy"].filter((q) => cocok(q).length > 0).slice(0, 4);
const cara = hs.find((h) => h.id === "A0");
---
<div class="beranda not-content">
  <div class="beranda__depan">
    <section class="beranda__atas" data-layar-pertama="semua" aria-label="Mulai">
      {/* id = PAGE_TITLE_ID Starlight: tujuan tautan "Lewati ke konten" (keputusan 318). */}
      <h1 class="beranda__judul" id="_top">Rekeningo Tech Journey</h1>
      <p class="beranda__janji">Belajar backend lewat satu dompet digital fiktif yang tumbuh dari 100 karyawan sampai jutaan user.</p>
      <div class="beranda__aksi">
        {mulai && <a class="beranda__mulai" href={url(mulai)}>{prd ? "Mulai dari PRD" : "Mulai dari Tahap 1"} →</a>}
        <a class="beranda__lanjut" href="#" data-lanjut hidden>
          <span class="beranda__lanjut-label">Lanjutkan:</span>{" "}
          <span data-lanjut-judul></span>{" "}
          <span class="beranda__lanjut-status" data-lanjut-status></span>
        </a>
      </div>
      <nav class="beranda__pintu" aria-label="Tiga cara masuk">
        <a href="#peta"><b>Cerita</b><span>Enam tahap, satu PRD demi satu PRD</span></a>
        <a href="#peran"><b>Peran</b><span>Lima halaman untuk pekerjaanmu</span></a>
        <a href="#masalah"><b>Masalah</b><span>Cari dari gejala yang kamu lihat</span></a>
      </nav>
    </section>
    <section class="beranda__teka" data-layar-pertama="desktop" aria-label="Teka-teki">
      <Tebak client:visible data={tebakM4} tautan={tautanTebak} />
    </section>
  </div>

  <section id="peta" class="beranda__bagian" aria-labelledby="judul-peta">
    <h2 id="judul-peta">Cerita: enam tahap, satu PRD demi satu PRD</h2>
    <p class="beranda__sub">Pilih satu tahap untuk melihat user-nya, siapa yang membuat, dan bentuk sistemnya.</p>
    <div class="peta__tab" role="tablist" aria-label="Enam tahap" data-tahap={tahap[0]!.no}>
      {tahap.map((t, i) => (
        <button type="button" role="tab" data-no={t.no} id={`tab-tahap-${t.no}`} aria-controls={`panel-tahap-${t.no}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
          class:list={["peta__pilih", { "is-lama": t.lama, "is-proyeksi": !t.href }]}>
          <span class="peta__no">{t.no}</span>
          <span class="peta__nama">{t.skala?.pendek ?? t.nama}</span>
          {t.skala && <span class="peta__user">{t.skala.user.split(",")[0]}</span>}
        </button>
      ))}
    </div>
    <div class="peta__isi">
      <div class="peta__daftar">
        {tahap.map((t, i) => (
          <div role="tabpanel" id={`panel-tahap-${t.no}`} aria-labelledby={`tab-tahap-${t.no}`} class="peta__panel" data-panel hidden={i !== 0}>
            <div class="peta__info">
              <h3>Tahap {t.no} · {t.skala?.lingkup ?? t.nama}</h3>
              {t.skala && (
                <dl>
                  <div><dt>PRD</dt><dd>{t.skala.prd.replace(/^PRD v\d+( \(proyeksi\))?: /, "")}</dd></div>
                  <div><dt>User</dt><dd>{t.skala.user}</dd></div>
                  <div><dt>Yang membuat</dt><dd>{t.skala.pembuat}</dd></div>
                </dl>
              )}
              <p class="peta__status">{t.status}</p>
              {t.href && <a class="peta__buka" href={t.href}>{t.no === 1 && prd ? "Mulai dari PRD v1" : `Buka Tahap ${t.no}`} →</a>}
            </div>
          </div>
        ))}
      </div>
      <PetaDiagram client:visible tahap={diagramTahap} />
    </div>
  </section>

  <section id="peran" class="beranda__bagian" aria-labelledby="judul-peran">
    <h2 id="judul-peran">Peran: sehari-hari kamu mengerjakan apa?</h2>
    <p class="beranda__sub">Pilih satu. Kamu mendapat lima halaman untuk dibaca dulu, dan sidebar menyorot halaman lain untuk peran itu.</p>
    <div class="peran__tanya" role="group" aria-label="Pilih peran">
      {PERAN.map(([v, l]) => <button type="button" class="peran__jawab" data-peran-pilih={v} aria-pressed="false">{l}</button>)}
    </div>
    {PERAN.map(([v]) => (
      <div class="peran__saran" data-saran={v} hidden>
        {saranPeran[v]!.length > 0 ? (
          <ol>{saranPeran[v]!.map((x) => <li><a href={x.u}>{x.l}</a>{x.m ? <span> · {x.m} menit</span> : null}</li>)}</ol>
        ) : (
          <p>Halaman untuk peran ini mulai muncul di Tahap 3. Sementara itu, mulai dari jalur inti: <a href={saranPeran.generalis![0]?.u}>{saranPeran.generalis![0]?.l}</a>.</p>
        )}
      </div>
    ))}
  </section>

  <section id="masalah" class="beranda__bagian" aria-labelledby="judul-masalah">
    <h2 id="judul-masalah">Masalah: apa yang kamu lihat?</h2>
    <label class="beranda__sub" for="cari-masalah">Ketik gejalanya, seperti yang dilihat user atau Keuangan.</label>
    <input id="cari-masalah" class="masalah__cari" type="search" placeholder="mis. saldo hilang" autocomplete="off" />
    <p class="masalah__saran">
      <span>Coba:</span>
      {saranCari.map((q) => <button type="button" class="masalah__chip" data-isi={q}>{q}</button>)}
    </p>
    <ul class="masalah__hasil" role="status" aria-live="polite"></ul>
  </section>

  {cara && <p class="beranda__kecil"><a href={url(cara)}>Cara pakai panduan ini</a></p>}
</div>
<script type="application/json" id="data-masalah" set:html={JSON.stringify(masalah)} />
<style is:inline set:html={cssPeta + "\n" + cssPesan} />

<script>
  const simpanan = (k: string): string | null => { try { return localStorage.getItem(k); } catch { return null; } };

  // Kartu Lanjutkan: halaman terakhir yang dibuka (ditulis KamuDiSini.astro) dan jumlah blok yang selesai.
  const lanjut = document.querySelector<HTMLAnchorElement>("[data-lanjut]");
  try {
    const t = JSON.parse(simpanan("rtj-terakhir") || "null") as { u: string; j: string; n: number } | null;
    if (lanjut && t?.u && t.j) {
      const selesai = (JSON.parse(simpanan("rtj-blok:" + t.u) || "[]") as string[]).length;
      lanjut.href = t.u;
      lanjut.querySelector("[data-lanjut-judul]")!.textContent = t.j;
      lanjut.querySelector("[data-lanjut-status]")!.textContent = t.n ? `${Math.min(selesai, t.n)} dari ${t.n} blok selesai` : "";
      lanjut.hidden = false;
    }
  } catch { /* data rusak: kartu tetap tersembunyi */ }

  // Peta tahap: tab dengan panah kiri/kanan.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".peta__pilih")];
  // Diagram (PetaDiagram.tsx) mengikuti tab lewat event; data-tahap untuk island yang di-hydrate sesudah tab dipilih.
  const daftarTab = document.querySelector<HTMLElement>(".peta__tab");
  const pilihTab = (b: HTMLButtonElement, fokus = false) => {
    for (const x of tabs) {
      const aktif = x === b;
      x.setAttribute("aria-selected", String(aktif));
      x.tabIndex = aktif ? 0 : -1;
      document.getElementById(x.getAttribute("aria-controls")!)!.hidden = !aktif;
    }
    if (fokus) b.focus();
    if (daftarTab) daftarTab.dataset.tahap = b.dataset.no;
    document.dispatchEvent(new CustomEvent("rtj:peta-tahap", { detail: Number(b.dataset.no) }));
  };
  tabs.forEach((b, i) => {
    b.addEventListener("click", () => pilihTab(b));
    b.addEventListener("keydown", (e) => {
      const arah = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (arah) { e.preventDefault(); pilihTab(tabs[(i + arah + tabs.length) % tabs.length]!, true); }
    });
  });

  // Peran: sama dengan pemilih di sidebar (localStorage rtj-peran); saran tampil setelah memilih.
  const pakai = (p: string | null) => {
    if (p) document.documentElement.dataset.peran = p;
    document.querySelectorAll<HTMLButtonElement>("[data-peran-pilih]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.peranPilih === p)));
    document.querySelectorAll<HTMLElement>("[data-saran]").forEach((el) => { el.hidden = el.dataset.saran !== p; });
  };
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-peran-pilih]");
    if (!b) return;
    try { localStorage.setItem("rtj-peran", b.dataset.peranPilih!); } catch { /* mode privat */ }
    pakai(b.dataset.peranPilih!);
  });
  pakai(simpanan("rtj-peran"));

  // Pencarian masalah.
  const data: { m: string; l: string; u: string }[] = JSON.parse(document.getElementById("data-masalah")!.textContent!);
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const input = document.getElementById("cari-masalah") as HTMLInputElement;
  const hasil = document.querySelector(".masalah__hasil")!;
  const tampil = () => {
    const kata = norm(input.value).split(/\s+/).filter(Boolean);
    hasil.replaceChildren();
    if (!kata.length) return;
    const cocok = data.filter((x) => { const t = norm(x.m + " " + x.l); return kata.every((k) => t.includes(k)); }).slice(0, 5);
    if (!cocok.length) { const li = document.createElement("li"); li.textContent = "Belum ada halaman untuk gejala itu. Coba kata lain, mis. saldo atau login."; hasil.append(li); return; }
    for (const x of cocok) {
      const li = document.createElement("li"), a = document.createElement("a"), s = document.createElement("span");
      a.href = x.u; a.textContent = x.l; s.textContent = x.m; li.append(a, s); hasil.append(li);
    }
  };
  input.addEventListener("input", tampil);
  document.querySelectorAll<HTMLButtonElement>("[data-isi]").forEach((b) => b.addEventListener("click", () => { input.value = b.dataset.isi!; tampil(); input.focus(); }));
</script>
