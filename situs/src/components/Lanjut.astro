---
/**
 * Mengganti Pagination Starlight: tautan Sebelumnya/Berikutnya mengikuti urutan baca registry (cerita.json),
 * bukan urutan sidebar. Tautan ke halaman yang belum ditulis diberi kelas menyusul (keputusan 104). Halaman lama yang
 * sudah punya pengganti tidak ada di urutan; tetangganya dihitung `tetangga()` (keputusan 1150, 1151).
 */
import { muat, tetangga, dariUrl, label, url, urlDariId } from "../../tools/registri.mjs";
const d = muat();
const sini = urlDariId(Astro.locals.starlightRoute.entry.id);
const { prev, next } = tetangga(d, dariUrl(d, sini));
---
{(prev || next) && Astro.locals.starlightRoute.entry.data.template !== "splash" && (
  <nav class="bb-lanjut" aria-label="Urutan baca">
    {prev && <a href={url(prev)} class:list={["bb-lanjut__prev", { menyusul: !prev.diporting }]} rel="prev"><span>← Sebelumnya</span>{label(prev)}</a>}
    {next && <a href={url(next)} class:list={["bb-lanjut__next", { menyusul: !next.diporting }]} rel="next"><span>Berikutnya →</span>{label(next)}</a>}
  </nav>
)}
{Astro.locals.starlightRoute.entry.data.template !== "splash" && (
  <p class="catatan-fiktif">{d.app}, Grup Lestari, semua tokoh, dan semua angka cerita di panduan ini fiktif.</p>
)}
