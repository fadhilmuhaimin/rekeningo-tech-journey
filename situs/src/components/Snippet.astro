---
/**
 * Sisip kode lab ke halaman, pengganti `--8<-- "labs/x/main.go:transfer"` (pymdownx.snippets).
 *   <Snippet file="labs/b3-stack/go/main.go" region="transfer" lang="go" />
 *   <Snippet file="labs/b3-stack/output/go-transfer.txt" title="Output rekaman" />
 *   <Snippet lang="java" code={`...`} />      kode yang tidak dijalankan di lab (label ditulis di prosa)
 * Penanda region sama dengan lab: `// --8<-- [start:transfer]` ... `// --8<-- [end:transfer]`.
 * Teks dari berkas lab tampil tanpa rujukan internal di komentarnya ("(keputusan 430)", "(tinjauan PR 340)"): berkas
 * dan rekaman tidak diubah, hanya tampilannya (keputusan 1180, `lib/rujukan-internal.ts`). Kode yang ditulis langsung
 * di prop `code` tidak disaring: penulisnya membuang rujukan itu sendiri.
 * File atau region yang tidak ada menggagalkan build. Setiap baris mendapat id `__span-<kunci>-<n>`,
 * kontrak DOM yang dibaca widget stackstep lama (keputusan 103).
 */
import fs from "node:fs";
import path from "node:path";
import { createHash } from "node:crypto";
import { codeToHtml } from "shiki";
import { ROOT } from "../../tools/registri.mjs";
import { temaShiki } from "../lib/shiki-tema.mjs";
import { bersihkanRujukanInternal } from "../lib/rujukan-internal";

interface Props { file?: string; files?: string[]; region?: string; lines?: string; lang?: string; title?: string; code?: string }
const { file, files, region, lines: rentang, lang = "text", title, code } = Astro.props;

let src: string;
if (code != null) {
  src = code;
} else if (files) {
  // Beberapa file rekaman digabung berurutan (pola fence dengan beberapa baris --8<-- di MkDocs)
  // Setiap entri boleh membawa rentang baris: "path:awal:akhir"
  src = files.map((f) => {
    const m = f.match(/^(.*?)(?::(\d*):(\d*))?$/);
    if (!m) throw new Error(`Snippet: entri file tidak terbaca: ${f}`);
    const abs = path.join(ROOT, m[1]);
    if (!fs.existsSync(abs)) throw new Error(`Snippet: file ${m[1]} tidak ada`);
    let isi = fs.readFileSync(abs, "utf8").replace(/\n+$/, "");
    if (m[2] !== undefined) {
      const semua = isi.split("\n");
      const a = m[2] ? Number(m[2]) : 1, b = m[3] ? Number(m[3]) : semua.length;
      if (a < 1 || b > semua.length || a > b) throw new Error(`Snippet: rentang ${m[2]}:${m[3]} di luar ${m[1]} (${semua.length} baris)`);
      isi = semua.slice(a - 1, b).join("\n");
    }
    return isi;
  }).join("\n");
} else {
  if (!file) throw new Error("Snippet: butuh prop file atau code");
  const abs = path.join(ROOT, file);
  if (!fs.existsSync(abs)) throw new Error(`Snippet: file ${file} tidak ada`);
  src = fs.readFileSync(abs, "utf8");
  if (rentang) {
    // Rentang baris "awal:akhir" (1-based, inklusif), pola pymdownx `--8<-- "file:1:13"`; salah satu boleh kosong
    const m = rentang.match(/^(\d*):(\d*)$/);
    if (!m) throw new Error(`Snippet: rentang baris ${rentang} tidak valid`);
    const semua = src.split("\n");
    const a = m[1] ? Number(m[1]) : 1, b = m[2] ? Number(m[2]) : semua.length;
    if (a < 1 || b > semua.length || a > b) throw new Error(`Snippet: rentang ${rentang} di luar ${file} (${semua.length} baris)`);
    src = semua.slice(a - 1, b).join("\n");
  }
  if (region) {
    const lines = src.split("\n");
    const mulai = lines.findIndex((l) => l.includes(`--8<-- [start:${region}]`));
    const akhir = lines.findIndex((l) => l.includes(`--8<-- [end:${region}]`));
    if (mulai < 0 || akhir < 0 || akhir <= mulai) throw new Error(`Snippet: region ${region} tidak ada di ${file}`);
    src = lines.slice(mulai + 1, akhir).join("\n");
  }
}
// Baris penanda region lain di dalam potongan tidak ikut tampil (perilaku pymdownx.snippets).
src = src.split("\n").filter((l) => !l.includes("--8<-- [")).join("\n").replace(/\n+$/, "");
if (code == null) src = bersihkanRujukanInternal(src);

const kunci = createHash("md5").update(file ?? files?.join("|") ?? code ?? "").update(region ?? rentang ?? "").digest("hex").slice(0, 6);
const html = await codeToHtml(src, {
  lang,
  theme: temaShiki,
  transformers: [{ line(node, i) { node.properties.id = `__span-${kunci}-${i}`; } }],
});
---
<div class:list={["highlight", "bb-snippet", { "has-title": !!title }]} data-file={file ?? files?.join(" ")} data-region={region}>
  {title && <span class="filename">{title}</span>}
  <Fragment set:html={html} />
</div>
