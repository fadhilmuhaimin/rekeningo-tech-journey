---
/**
 * Satu blok lipat halaman (keputusan 118): judul h2 di dalam summary (ikut daftar isi dan penyorotnya),
 * "Blok n dari N · m menit", status selesai, dan tombol Berikutnya di akhir. Blok terakhir menunjuk halaman
 * berikutnya di urutan baca. Status selesai (keputusan 203) hanya diberikan setelah blok terbuka dan akhirnya
 * benar-benar digulir ke layar, atau tombol Berikutnya ditekan; membuka saja belum berarti dibaca. Status disimpan
 * per halaman di localStorage; tanpa JavaScript blok tetap
 * bisa dibuka dan ditutup. Tidak ada animasi yang jalan sendiri; scroll halus hanya bila reduced motion tidak aktif.
 *   <Blok nama="Coba" buka aman="Kalau berhenti di sini, kamu sudah tahu ...">...</Blok>
 * Blok cerita boleh membawa ilustrasi kecil di awalnya (keputusan 207): <Blok nama="Gejala" buka ilustrasi="m1">.
 * Saat pembaca membuka atau menutup blok dengan klik atau keyboard, isinya tumbuh dari kepala atau kembali ke kepala
 * (src/gerak/lipat.ts, keputusan 238); tidak saat dimuat, tidak lewat tautan #, tidak bila reduced motion.
 */
import { daftarBlok, slugBlok, menitBlok } from "../lib/blok";
import Ilustrasi from "./Ilustrasi.astro";
import { muat, tetangga, label, url, urlDariId, dariUrl } from "../../tools/registri.mjs";

interface Props { nama: string; buka?: boolean; menit?: number; aman?: string; ilustrasi?: string }
const { nama, buka = false, aman, ilustrasi } = Astro.props;
const route = Astro.locals.starlightRoute;
const bloks = daftarBlok(route.entry.body ?? "");
const i = bloks.findIndex((b) => b.nama === nama);
if (i < 0) throw new Error(`Blok "${nama}" tidak ditemukan di ${route.entry.id}`);
const d = muat();
const sini = urlDariId(route.entry.id);
const h = dariUrl(d, sini);
const menit = menitBlok(h?.jenis, bloks[i]!);
const next = bloks[i + 1];
let halBerikut: { nomor?: string; judul: string; path: string } | null = null;
if (!next) halBerikut = tetangga(d, h).next;
const id = slugBlok(nama);
---
<details class="blok" data-blok={id} open={buka}>
  <summary class="blok__kepala">
    <h2 id={id} class="blok__judul">{nama}</h2>
    <span class="blok__meta">Blok {i + 1} dari {bloks.length}{menit ? ` · ${menit} menit` : ""}<span class="blok__status" data-status></span></span>
  </summary>
  <div class="blok__isi">
    {ilustrasi && <Ilustrasi nama={ilustrasi} />}
    <slot />
    {aman && <p class="blok__aman">{aman}</p>}
    <span class="blok__akhir" data-akhir-blok aria-hidden="true"></span>
    {next && (
      <p class="blok__lanjut-baris">
        <button type="button" class="blok__lanjut" data-ke={slugBlok(next.nama)}>Berikutnya: {next.nama} <span aria-hidden="true">→</span></button>
      </p>
    )}
    {!next && halBerikut && (
      <p class="blok__lanjut-baris">
        <a class="blok__lanjut" href={url(halBerikut)} data-akhir>Berikutnya: {label(halBerikut)} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</details>

<script>
  import { alihkan, hentikan, lipat } from "../gerak/lipat";
  // Sama dengan KUNCI_BLOK di lib/selesai.ts (diperiksa selesai.test.ts); ditulis di sini supaya halaman berblok tidak
  // memuat satu chunk lagi hanya untuk konstanta.
  const kunci = "rtj-blok:" + location.pathname;
  const baca = (): string[] => { try { return JSON.parse(localStorage.getItem(kunci) || "[]"); } catch { return []; } };
  const simpan = (a: string[]) => { try { localStorage.setItem(kunci, JSON.stringify(a)); } catch { /* mode privat */ } };
  const blok = () => [...document.querySelectorAll<HTMLDetailsElement>("details.blok")];

  function tandai() {
    const selesai = new Set(baca());
    for (const el of blok()) {
      const id = el.dataset.blok!;
      const sudah = selesai.has(id);
      el.classList.toggle("blok--selesai", sudah);
      const st = el.querySelector("[data-status]");
      if (st) st.textContent = sudah ? " · selesai" : "";
      document.querySelectorAll(`a[href="#${id}"]`).forEach((a) => a.classList.toggle("toc-selesai", sudah));
    }
  }
  function selesaikan(el: HTMLDetailsElement) {
    const a = baca();
    if (!a.includes(el.dataset.blok!)) simpan([...a, el.dataset.blok!]);
  }
  function bukaDariHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = blok().find((x) => x.dataset.blok === id);
    if (el) { hentikan(el); el.open = true; }
  }

  document.addEventListener("click", (e) => {
    const t = (e.target as Element).closest<HTMLElement>(".blok__lanjut");
    if (!t) return;
    const kini = t.closest<HTMLDetailsElement>("details.blok");
    if (!kini) return;
    selesaikan(kini);
    if (t.dataset.ke) {
      digulir = false;
      const lanjut = blok().find((x) => x.dataset.blok === t.dataset.ke);
      // Blok yang selesai langsung tertutup tanpa gerak. Isinya ada di atas tombol, jadi kepala blok tujuan ikut naik
      // setinggi isi itu (K1xe, keputusan 257). Gulir dikoreksi seketika sebesar pergeseran itu: kepala blok tujuan
      // tetap di tempatnya, sejauh halaman bisa digulir. Lalu blok tujuan terbuka dengan gerak dan digulir halus ke
      // atas layar.
      const atasSebelum = lanjut?.getBoundingClientRect().top ?? 0;
      hentikan(kini);
      kini.open = false;
      if (lanjut) {
        const geser = lanjut.getBoundingClientRect().top - atasSebelum;
        if (geser) scrollBy({ top: geser, behavior: "instant" });
        lipat(lanjut, true);
        const halus = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        lanjut.scrollIntoView({ behavior: halus ? "smooth" : "auto", block: "start" });
        lanjut.querySelector("summary")?.focus({ preventScroll: true });
      }
    }
    tandai();
  });
  // Selesai karena digulir: akhir blok yang terbuka masuk layar saat pembaca menggulir sendiri (roda, sentuh,
  // atau tombol). Gulir otomatis dari Berikutnya atau tautan # tidak dihitung, jadi blok yang baru dibuka belum selesai.
  let digulir = false, antre = false;
  function cekAkhir() {
    antre = false;
    if (!digulir) return;
    const selesai = new Set(baca());
    let berubah = false;
    for (const el of blok()) {
      if (!el.open || selesai.has(el.dataset.blok!)) continue;
      const akhir = el.querySelector("[data-akhir-blok]");
      if (akhir && akhir.getBoundingClientRect().top < innerHeight) { selesaikan(el); berubah = true; }
    }
    if (berubah) tandai();
  }
  const olehPembaca = () => { digulir = true; };
  addEventListener("wheel", olehPembaca, { passive: true });
  addEventListener("touchmove", olehPembaca, { passive: true });
  addEventListener("keydown", (e) => { if (["ArrowDown", "PageDown", "End", " "].includes(e.key)) digulir = true; });
  addEventListener("scroll", () => { if (digulir && !antre) { antre = true; requestAnimationFrame(cekAkhir); } }, { passive: true });
  // Klik atau Enter/Spasi di kepala blok: buka/tutup dengan gerak (keputusan 238), menggantikan transisi CSS 207.
  document.addEventListener("click", (e) => {
    const kepala = (e.target as Element).closest?.("summary.blok__kepala");
    const el = kepala?.parentElement;
    if (!(el instanceof HTMLDetailsElement) || !el.matches("details.blok")) return;
    e.preventDefault();
    alihkan(el);
  });
  window.addEventListener("hashchange", bukaDariHash);
  bukaDariHash();
  tandai();
</script>
